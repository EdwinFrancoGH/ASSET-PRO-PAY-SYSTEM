# Copia este archivo a ".env" y ajusta los valores.
PORT=5000

# URL del frontend: se usa para los enlaces de los correos de aviso
# ("Ver petición") y para CORS.
FRONTEND_URL=http://localhost:3000

# El backend espera el archivo de credenciales de Firebase Admin en:
#   backend/credentials/firebase-key.json

# Carpeta donde se guardan los adjuntos (proformas y comprobantes).
# Por defecto: backend/uploads
UPLOADS_DIR=

# Tamaño máximo por archivo, en MB.
MAX_FILE_MB=10

# --- Avisos por correo ---
# Opcional: si lo dejas vacío, las notificaciones dentro de la app
# funcionan igual; solo se omite el correo (se avisa en consola).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
